root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.{c,cc,cpp,h,hpp,inl}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
